# Template for docker/.env — copy this file to `.env` and fill in real values:
#   cp docker/.env.example docker/.env
# docker compose (run from the docker/ dir) auto-loads docker/.env for ${VAR} interpolation.

# Postgres
POSTGRES_DB=debetter
POSTGRES_USER=debetter_user
POSTGRES_PASSWORD=change_me

# Redis
REDIS_PASSWORD=change_me
